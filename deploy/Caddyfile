{
	# Keep the administration endpoint inside the container.
	admin off
	email {$ACME_EMAIL}
}

{$EASYACR_PUBLIC_HOST} {
	encode zstd gzip

	# The scanner API accepts small JSON requests only. This also prevents a
	# public reverse-proxy upload endpoint from being introduced accidentally.
	request_body {
		max_size 64KB
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self' https://{$SUPABASE_HOST}; img-src 'self' data:; font-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
	}

	reverse_proxy app:4174 {
		# Do not forward a user-controlled forwarding chain. The app is reachable
		# only on an internal network and can trust this single Caddy-provided IP.
		header_up -X-Forwarded-For
		header_up X-Forwarded-For {remote_host}
		header_up -X-Forwarded-Host
		header_up X-Forwarded-Host {host}
		header_up -X-Forwarded-Proto
		header_up X-Forwarded-Proto {scheme}
	}
}

# The application owns identity and the public product experience. Keep www as
# a canonical handoff so a host-only app session never needs to be shared with
# the marketing domain, and no route can fall back to the legacy mock build.
www.easyacr.com {
	redir https://app.easyacr.com{uri} permanent
}

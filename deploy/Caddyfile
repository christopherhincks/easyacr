{
	# Keep the administration endpoint inside the container.
	admin off
	email {$ACME_EMAIL}
}

{$EASYACR_PUBLIC_HOST} {
	encode zstd gzip

	# The scanner API accepts small JSON requests only. This also prevents a
	# public reverse-proxy upload endpoint from being introduced accidentally.
	request_body {
		max_size 64KB
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self' https://{$SUPABASE_HOST}; img-src 'self' data:; font-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
	}

	reverse_proxy app:4174 {
		# Do not forward a user-controlled forwarding chain. The app is reachable
		# only on an internal network and can trust this single Caddy-provided IP.
		header_up -X-Forwarded-For
		header_up X-Forwarded-For {remote_host}
		header_up -X-Forwarded-Host
		header_up X-Forwarded-Host {host}
		header_up -X-Forwarded-Proto
		header_up X-Forwarded-Proto {scheme}
	}
}

# The marketing site remains on its existing host while the product moves to
# app.easyacr.com. Product-shaped paths must never land in the legacy mock
# build: they preserve their path and query string when handed to the app.
www.easyacr.com {
	@product_path path /account /account/* /tools /tools/* /scans /scans/*
	redir @product_path https://app.easyacr.com{uri} permanent

	# Keep the public marketing homepage and content available during the
	# transition. The numeric upstream deliberately bypasses Cloudflare, so the
	# proxy cannot loop back through this Caddy instance after DNS is changed.
	reverse_proxy https://64.22.68.21 {
		header_up Host www.easyacr.com
		transport http {
			tls_server_name www.easyacr.com
		}
	}
}

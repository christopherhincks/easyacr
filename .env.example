# Required to issue signed application sessions. Generate distinct high-entropy values.
SESSION_HMAC_SECRET=

# Required for public self-service authentication. The publishable key may be
# exposed to the browser; the service-role key must never be added to Vite.
SUPABASE_URL=
SUPABASE_HOST=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_GATEWAY_TOKEN=
DATA_GATEWAY_TOKEN=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mandatory controlled egress proxy for Chromium. It must independently block
# private, link-local, loopback, metadata, multicast, reserved, and rebinding targets.
SCAN_EGRESS_PROXY=

NODE_ENV=production
PORT=4174
